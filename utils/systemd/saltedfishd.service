[Unit]
Description=Monero Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/saltedfishd --config-file /etc/monero/saltedfishd.conf --non-interactive

Restart=always
RestartSec=30

User=saltedfish
Group=saltedfish

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
